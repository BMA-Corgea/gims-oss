    "archive_sql_db": "GIMS_Aurora_Archive",
    "nodes_db": "GIMS_Aurora_Nodes",
    "logins_db": "GIMS_Aurora_Logins"
  },
  "engine": "aurora-postgresql",
  "default_db": "postgres",
  "sslmode": "require"
}
